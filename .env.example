# ---------------------------------------------------------------------------
# Iraq PropTech — environment variables
# Copy to .env and fill in. NEVER commit .env.
# Every external service is optional: with the defaults below the platform
# runs fully in DEMO/MOCK mode at $0.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
APP_ENV=development              # development | test | production
APP_NAME="Iraq PropTech"
LOG_LEVEL=INFO
LOG_JSON=true                    # structured JSON logs

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
# Local Docker / Codespaces:
DATABASE_URL=postgresql+psycopg://proptech:proptech@localhost:5432/proptech
# Supabase (temporary dev only) — use the *session pooler* or direct URL:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Redis (optional in dev; required for the Celery worker) --------------
REDIS_URL=redis://localhost:6379/0

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
# URL the Next.js server uses to reach the API at runtime
# (Codespaces/local: http://localhost:8000 — inside Docker: http://backend:8000).
# The browser calls the frontend's own /api/v1/* which proxies here, so no CORS
# or public API URL is needed by default.
API_INTERNAL_URL=http://localhost:8000
# Optional: make the browser call the API directly instead (then add the
# frontend origin to CORS_ORIGINS). Inlined at build time.
NEXT_PUBLIC_API_URL=

# --- Maps (read by the frontend server at runtime; no API key needed) -------
# openfreemap (free vector tiles, default) | osm-raster (dev only) | custom
MAP_PROVIDER=openfreemap
# Self-hosted style JSON (e.g. PMTiles on the production PC); overrides MAP_PROVIDER
MAP_STYLE_URL=
MAP_ATTRIBUTION=
# Initial map view "west,south,east,north". Basra first; empty = all of Iraq.
MAP_DEFAULT_BBOX=47.65,30.40,47.95,30.62
# Arabic label shaping for vector tiles; set empty to disable
# MAP_RTL_PLUGIN_URL=https://unpkg.com/@mapbox/mapbox-gl-rtl-text@0.3.0/dist/mapbox-gl-rtl-text.js

# --- AI (mock = deterministic, offline, free; no key needed) ----------------
AI_PROVIDER=mock
# AI_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
AI_DAILY_LIMIT_PER_USER=100

# --- Notifications & automation ---------------------------------------------
# SMS: mock (records only, default) | http (POST {to,text} to your gateway; needs URL+token)
SMS_PROVIDER=mock
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=
# Webhooks (n8n etc.) must be https on a public host unless explicitly allowed:
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# Deliver notifications from the API process right after commit (no worker needed)
NOTIFICATIONS_INLINE=false
# Worker embeds the scheduler (beat); run exactly one worker with WORKER_BEAT=1
WORKER_BEAT=1

# --- Analytics ---------------------------------------------------------------
# Day boundaries in minutes from UTC (Iraq = 180, no DST)
ANALYTICS_UTC_OFFSET_MINUTES=180

# --- Payments (demo = simulated checkout, no money moves; none = disabled) -----
PAYMENT_PROVIDER=demo
# Production forces "none" unless this is set deliberately (public demo site)
PAYMENT_DEMO_IN_PRODUCTION=false
